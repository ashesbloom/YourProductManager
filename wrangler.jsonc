{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ypm",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    // Every non-API route serves index.html; only these paths run the Worker (page loads stay free).
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/media/*"]
  },
  "d1_databases": [
    // database_id: replace with the id from `wrangler d1 create ypm --location apac` before any remote command.
    { "binding": "DB", "database_name": "ypm", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "ypm-media" }],
  "vars": { "EMAIL_FROM": "YPM <no-reply@yourpm.in>" },
  "observability": { "enabled": true }
}
